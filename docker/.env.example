# Loopback-only lab placeholders. Compose binds 0.0.0.0 inside the container
# (non-loopback); replace both values with unique roots before compose up or
# startup refuses the shipped example pair. Host publish stays 127.0.0.1:4566.
NOCTAXRIS_ROOT_ACCESS_KEY_ID=AKIAROOTEXAMPLE01
NOCTAXRIS_ROOT_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Nested DinD (set automatically in compose.yaml for the noctaxris service).
# Empty outside Compose disables compute for unit tests.
# NOCTAXRIS_DOCKER_HOST=tcp://noctaxris-engine:2376
# NOCTAXRIS_DOCKER_CERT_PATH=/certs/client

# API URL injected into function containers (DinD children). Default suits
# Docker Desktop via host.docker.internal to host-published 127.0.0.1:4566.
# NOCTAXRIS_LAMBDA_ENDPOINT_URL=http://host.docker.internal:4566

# In-function SDK labs: use compose.lab-host-gateway.yaml (keeps code default off).
# Nested ECS / CodeBuild / Batch task→API labs: use compose.lab-ecs-host-gateway.yaml.
# On Docker Desktop DinD, host-gateway may need a non-loopback publish for that session:
# NOCTAXRIS_INJECT_HOST_GATEWAY=1
# NOCTAXRIS_INJECT_ECS_HOST_GATEWAY=1
# NOCTAXRIS_PUBLISH_ADDR=0.0.0.0

# Optional compute runtime (nested DinD only; see docs/configuration.md).
# NOCTAXRIS_COMPUTE_RUNTIME=dind

# Shared DinD Kafka (Redpanda) and MQTT (Mosquitto) for MSK / IoT wire labs.
# Defaults off. Use docker/compose.lab-brokers.yaml to opt in (no password MQTT).
# NOCTAXRIS_SHARED_KAFKA=1
# NOCTAXRIS_SHARED_MQTT=1
# Narrow engine publish for broker ports only (API dials noctaxris-engine:1883 / :9092).
# NOCTAXRIS_BROKER_PORT_PUBLISH=1
# Blanket nested data publish (all engine kinds); see compose.lab-nested-ports.yaml.
# NOCTAXRIS_NESTED_PORT_PUBLISH=1
# Neptune nested graph backend: gremlin (default) or neo4j (Bolt :7687).
# NOCTAXRIS_NEPTUNE_ENGINE=neo4j

# Compose sets NOCTAXRIS_MASTER_KEY_FILE=/var/lib/noctaxris-secrets/master.key
# on the noctaxris-secrets volume (outside noctaxris-data). Do not colocate
# master.key on the data volume unless you also set:
# NOCTAXRIS_ALLOW_MASTER_KEY_IN_DATA_ROOT=1
# NOCTAXRIS_MASTER_KEY_FILE=/var/lib/noctaxris/master.key
